{
  "name": "fiber-pulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "Consumer Fiber pay MVP — request, preflight, pay (mock-first, optional live RPC)",
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start -p 3060",
    "start:fnn": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-fnn-secure.ps1",
    "fund:merchant": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/fund-merchant-secure.ps1",
    "check:fiber": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-fiber-rpc.ps1",
    "check:rpc": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-rpc.ps1",
    "prove:l1-live": "node ./scripts/prove-l1-live.mjs",
    "prove:l1-fund-claim": "node ./scripts/prove-l1-fund-claim.mjs",
    "prove:fiber-security": "node ./scripts/prove-fiber-security.mjs",
    "prove:fiber-live": "node ./scripts/prove-fiber-live.mjs",
    "prove:fiber-execution": "node ./scripts/prove-fiber-execution.mjs",
    "prove:fiber-invoice": "node ./scripts/prove-fiber-invoice.mjs",
    "prove:fiber-grant": "node ./scripts/prove-fiber-grant.mjs",
    "prove:fiber-watch": "node ./scripts/prove-fiber-watch.mjs",
    "prove:fiber-tracking": "node ./scripts/prove-fiber-tracking.mjs",
    "prove:fiber-two-node": "node ./scripts/prove-fiber-two-node.mjs",
    "prove:fiber-webhook": "node --no-warnings --experimental-strip-types ./scripts/prove-fiber-webhook.mjs",
    "prove:state-store": "node --no-warnings --experimental-strip-types ./scripts/prove-state-store.mjs",
    "worker:webhooks": "node --no-warnings --experimental-strip-types ./scripts/settlement-webhook-worker.mjs",
    "sync:deployment": "node ./scripts/sync-deployment.mjs",
    "run:all": "node ./scripts/run-all.mjs"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.9.0",
    "next": "15.5.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3"
  }
}
