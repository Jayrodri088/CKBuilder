# Server-only Fiber configuration. Never expose these with NEXT_PUBLIC_ variables.
FIBER_RPC_URL=http://127.0.0.1:8227
FNN_AUTH_TOKEN=
FNN_CLI_PATH=D:\CKB\fiber-bin\fnn-cli.exe

# Dry-run route proof is bounded and enabled by default.
FIBER_PAYMENT_PROOF_ENABLED=true
FIBER_PAYMENT_TARGET_PUBKEY=
FIBER_PAYMENT_MAX_CKB=0.05
FIBER_PAYMENT_COOLDOWN_MS=30000

# Keep false except during a trusted operator window.
FIBER_PAYMENT_EXECUTION_ENABLED=false
FIBER_PAYMENT_EXECUTION_TOKEN=
